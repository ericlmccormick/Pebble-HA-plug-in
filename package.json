{
  "name": "pebble-home-assistant-plugin",
  "author": "Eric McCormick",
  "version": "1.0.1",
  "pebble": {
    "displayName": "Home Assistant Bridge",
    "uuid": "a74370b6-929c-4ec0-b7ee-2fc6fca8db57",
    "sdkVersion": "3",
    "manifestVersion": 2,
    "projectType": "plugin",
    "configPage": "src/config.html",
    "usesPermissions": [
      "Internet",
      "LocalNetwork",
      "ShowNotifications"
    ],
    "plugin": {
      "description": "Reusable Home Assistant bridge: entities, Assist, secure TTS, and controls. Audio SDK integration: https://github.com/ericlmccormick/Pebble-HA-plug-in/tree/main/sdk",
      "script": "src/plugin/index.js",
      "definesPermissions": [
        {
          "name": "HomeRead",
          "label": "Read Home Assistant entities and configuration",
          "kind": "read"
        },
        {
          "name": "HomeConverse",
          "label": "Send messages to Home Assistant conversation agent",
          "kind": "exfiltrating"
        },
        {
          "name": "HomeControl",
          "label": "Control Home Assistant devices and services",
          "kind": "dangerous"
        }
      ],
      "sources": [
        {
          "category": "agent",
          "items": [
            "entity"
          ],
          "properties": {
            "name": [
              "shortText"
            ],
            "entity_id": [
              "shortText"
            ],
            "domain": [
              "shortText"
            ],
            "state": [
              "shortText",
              "longText"
            ],
            "value": [
              "numericValue"
            ],
            "on": [
              "boolean"
            ],
            "unit": [
              "shortText"
            ]
          },
          "supportsMultiple": true,
          "suggestedRefreshIntervalSec": 30,
          "callerPermissions": [
            "HomeRead"
          ]
        },
        {
          "category": "agent",
          "items": [
            "configured"
          ],
          "properties": {
            "name": [
              "shortText"
            ],
            "configured": [
              "boolean"
            ]
          },
          "supportsMultiple": false,
          "suggestedRefreshIntervalSec": 120,
          "callerPermissions": [
            "HomeRead"
          ]
        }
      ],
      "actions": [
        {
          "name": "get_state",
          "description": "Read one Home Assistant entity and its attributes.",
          "parameters": {
            "type": "object",
            "properties": {
              "entity_id": {
                "type": "string"
              }
            },
            "required": [
              "entity_id"
            ]
          },
          "callerPermissions": [
            "HomeRead"
          ]
        },
        {
          "name": "list_states",
          "description": "Read Home Assistant entities, optionally filtered by domain. Returns a bounded list.",
          "parameters": {
            "type": "object",
            "properties": {
              "domain": {
                "type": "string"
              },
              "limit": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100
              }
            },
            "additionalProperties": false
          },
          "callerPermissions": [
            "HomeRead"
          ]
        },
        {
          "name": "read_api",
          "description": "Read selected Home Assistant API endpoints without exposing authentication.",
          "parameters": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string"
              }
            },
            "required": [
              "path"
            ]
          },
          "callerPermissions": [
            "HomeRead"
          ]
        },
        {
          "name": "get_config",
          "description": "Get shared Home Assistant voice and AI defaults (STT, TTS, conversation agent, Assist pipeline). Never includes credentials.",
          "parameters": {
            "type": "object",
            "properties": {},
            "additionalProperties": false
          },
          "callerPermissions": [
            "HomeRead"
          ]
        },
        {
          "name": "conversation",
          "description": "Send a text request to the configured Home Assistant agent.",
          "parameters": {
            "type": "object",
            "properties": {
              "text": {
                "type": "string"
              },
              "agent_id": {
                "type": "string"
              },
              "conversation_id": {
                "type": "string"
              }
            },
            "required": [
              "text"
            ]
          },
          "callerPermissions": [
            "HomeConverse"
          ]
        },
        {
          "name": "send_to_agent",
          "description": "Send a spoken request from Index 01 to the configured Home Assistant Assist agent.",
          "parameters": {
            "type": "object",
            "properties": {
              "message": {
                "type": "string"
              },
              "chat_id": {
                "type": "string"
              }
            },
            "required": [
              "message"
            ]
          },
          "callerPermissions": [
            "HomeConverse"
          ]
        },
        {
          "name": "tts_prepare",
          "description": "Request mono PCM16 WAV from Home Assistant, verify, normalize/resample to canonical 8kHz 16-bit WAV for Gemini-style consumer-side ADPCM encoding. Set test_tone=true for a 2-second bridge-origin waveform and audio source statistics.",
          "parameters": {
            "type": "object",
            "properties": {
              "text": {
                "type": "string",
                "maxLength": 500
              },
              "engine_id": {
                "type": "string"
              },
              "test_tone": {
                "type": "boolean",
                "description": "Diagnostic only: return a bridge-generated 440 Hz PCM WAV instead of calling Home Assistant"
              },
              "source_rate": {
                "type": "integer",
                "enum": [
                  8000,
                  16000
                ],
                "description": "Optional requested PCM source sampling rate for comparing HA output; bridge always emits 8000Hz WAV"
              },
              "diagnostic": {
                "type": "boolean",
                "description": "Disable Home Assistant TTS caching for source comparison diagnostics"
              }
            },
            "required": []
          },
          "callerPermissions": [
            "HomeConverse"
          ]
        },
        {
          "name": "tts_chunk",
          "description": "Retrieve a bounded base64-encoded chunk of canonical 8kHz mono PCM16 WAV audio from a temporary session.",
          "parameters": {
            "type": "object",
            "properties": {
              "session_id": {
                "type": "string"
              },
              "offset": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "session_id",
              "offset"
            ]
          },
          "callerPermissions": [
            "HomeConverse"
          ]
        },
        {
          "name": "tts_release",
          "description": "Release a temporary TTS audio session.",
          "parameters": {
            "type": "object",
            "properties": {
              "session_id": {
                "type": "string"
              }
            },
            "required": [
              "session_id"
            ]
          },
          "callerPermissions": [
            "HomeConverse"
          ]
        },
        {
          "name": "render_template",
          "description": "Evaluate a Home Assistant Jinja template. Only grant to trusted watch apps.",
          "parameters": {
            "type": "object",
            "properties": {
              "template": {
                "type": "string"
              }
            },
            "required": [
              "template"
            ]
          },
          "callerPermissions": [
            "HomeControl"
          ]
        },
        {
          "name": "call_service",
          "description": "Invoke any Home Assistant service; may unlock doors or trigger dangerous operations.",
          "parameters": {
            "type": "object",
            "properties": {
              "domain": {
                "type": "string"
              },
              "service": {
                "type": "string"
              },
              "data": {
                "type": "object"
              },
              "target": {
                "type": "object"
              }
            },
            "required": [
              "domain",
              "service"
            ]
          },
          "callerPermissions": [
            "HomeControl"
          ]
        },
        {
          "name": "fire_event",
          "description": "Fire a Home Assistant event to trigger automations; may produce sensitive effects.",
          "parameters": {
            "type": "object",
            "properties": {
              "event_type": {
                "type": "string"
              },
              "event_data": {
                "type": "object"
              }
            },
            "required": [
              "event_type"
            ]
          },
          "callerPermissions": [
            "HomeControl"
          ]
        }
      ]
    }
  }
}
